# syntax=docker/dockerfile:1

# ----------------------------------------
# Stage 1: Install dependencies with Bun (the package manager bun.lock belongs to)
# ----------------------------------------
FROM oven/bun:1-alpine AS deps

WORKDIR /app

# Copy package manifests and lockfile first for better layer caching
COPY package.json bun.lock bunfig.toml ./

# Install all dependencies (dev + prod) because the build needs TypeScript/Tailwind/ESLint.
# Coolify may build a commit whose text lockfile was generated by a different Bun
# patch release, so allow Bun to reconcile it inside this disposable build layer.
RUN bun install

# ----------------------------------------
# Stage 2: Build the Next.js app (standalone output, see next.config.ts)
# ----------------------------------------
FROM node:22-alpine AS builder

WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=deps /app/node_modules ./node_modules
COPY . .

# NEXT_PUBLIC_* variables are inlined here, at build time (pass them as build args).
ARG NEXT_PUBLIC_UMAMI_WEBSITE_ID=""
ARG NEXT_PUBLIC_UMAMI_SRC=""
ENV NEXT_PUBLIC_UMAMI_WEBSITE_ID=$NEXT_PUBLIC_UMAMI_WEBSITE_ID
ENV NEXT_PUBLIC_UMAMI_SRC=$NEXT_PUBLIC_UMAMI_SRC
RUN node node_modules/next/dist/bin/next build

# ----------------------------------------
# Stage 3: Production runtime
# ----------------------------------------
FROM node:22-alpine AS runner

WORKDIR /app

# Default port; Coolify can override via environment variable PORT.
# DATABASE_URL is read at runtime by the /api routes; ADMIN_PASSWORD turns on the control panel.
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
# Each group's WhatsApp link and QR code, read by the server next to server.js (never served by URL).
COPY --from=builder /app/whatsapp-gruplari ./whatsapp-gruplari
# The standard page's content (ar/en/tr), the seed the control panel starts from.
COPY --from=builder /app/content ./content

# Everything the control panel writes (drafts, published pages, versions, trash, uploaded images)
# lives here. Mount a persistent volume at /app/data in Coolify, or edits are lost on redeploy.
ENV DATA_DIR=/app/data
RUN mkdir -p /app/data

EXPOSE 3000

# Start the self-contained Next.js server
CMD ["node", "server.js"]
