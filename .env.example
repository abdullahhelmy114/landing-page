# Umami visitor analytics (cookieless). Both are public and read at build time.
# Leave the id empty and no analytics script loads.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Umami script URL; empty means https://cloud.umami.is/script.js (set it for a self-hosted Umami).
NEXT_PUBLIC_UMAMI_SRC=

# Control panel (/admin). Set this in Coolify as a secret runtime variable; empty turns the panel off.
ADMIN_PASSWORD=
# Where the panel stores pages, versions, trash and uploads (the Docker image uses /app/data).
DATA_DIR=
